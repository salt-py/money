# Copy this file to .env and fill in real values. .env is gitignored and
# should never be shown to, or pasted into a chat with, an AI assistant.

# From https://developers.monzo.com -- register an OAuth client (confidential
# client, redirect URL must match MONZO_REDIRECT_URI below).
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:6600/monzo/callback

# Override the display name for a specific Monzo account -- needed when its
# API `description` field is empty (e.g. some shared/joint accounts), since
# without this the importer falls back to the account's raw id as the name,
# and a manually-renamed account would get a fresh duplicate on the next
# import rather than keeping the rename. Format: "id1:Name One,id2:Name Two".
MONZO_ACCOUNT_NAME_OVERRIDES=

# Categorization rules that reference a real, identifying value (an account
# number, say) go here instead of config/rules.yaml, which is git-tracked.
# See money/categorize.py:ENV_RULE_CATEGORIES for the full list this
# supports. Comma-separate multiple values to match any of them.
HOUSEHOLD_ACCOUNT_REF=
